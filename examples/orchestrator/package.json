{
  "name": "@reaatech/agent-mesh-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Mesh orchestrator — reference deployment example",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reaatech/agent-mesh": "workspace:*",
    "@reaatech/agent-mesh-classifier": "workspace:*",
    "@reaatech/agent-mesh-confidence": "workspace:*",
    "@reaatech/agent-mesh-gateway": "workspace:*",
    "@reaatech/agent-mesh-mcp-server": "workspace:*",
    "@reaatech/agent-mesh-observability": "workspace:*",
    "@reaatech/agent-mesh-registry": "workspace:*",
    "@reaatech/agent-mesh-router": "workspace:*",
    "@reaatech/agent-mesh-session": "workspace:*",
    "@reaatech/agent-mesh-utils": "workspace:*",
    "express": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/agent-mesh.git",
    "directory": "examples/orchestrator"
  }
}
